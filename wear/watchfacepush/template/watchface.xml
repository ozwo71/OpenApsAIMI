<WatchFace clipShape="CIRCLE" height="450" width="450">
    <Metadata key="CLOCK_TYPE" value="ANALOG" />
    <Scene backgroundColor="#ff000000">

        <!-- Lower half of the Custom watch face: background, images and the chart.
             Refreshed slowly, because that is what changes slowly. -->
        <ComplicationSlot
            name="CwfLower"
            slotId="0"
            displayName="Custom Watchface"
            isCustomizable="FALSE"
            supportedTypes="SMALL_IMAGE EMPTY"
            alpha="255"
            x="0" y="0" width="450" height="450">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY"
                primaryProvider="AAPS_WEAR_APP_ID/app.aaps.wear.complications.CwfLowerComplication"
                primaryProviderType="SMALL_IMAGE" />
            <BoundingBox x="0" y="0" width="450" height="450" />
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <!-- Upper half: clock, date fields, cover plate and hands, transparent elsewhere so the
             lower half shows through. Declared after the lower one, so it paints on top. -->
        <ComplicationSlot
            name="CwfUpper"
            slotId="1"
            displayName="Custom Watchface clock"
            isCustomizable="FALSE"
            supportedTypes="SMALL_IMAGE EMPTY"
            alpha="255"
            x="0" y="0" width="450" height="450">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY"
                primaryProvider="AAPS_WEAR_APP_ID/app.aaps.wear.complications.CwfUpperComplication"
                primaryProviderType="SMALL_IMAGE" />
            <BoundingBox x="0" y="0" width="450" height="450" />
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

    </Scene>
</WatchFace>
